# Supabase project URL (e.g. https://<project-id>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe in browser, restricted to public views
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase secret key — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# Public app URL — set per-environment in Vercel; optional locally (falls back
# to https://$VERCEL_URL when running on Vercel without an explicit value)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The single email allow-listed to sign in.
# Must match app.owner_email set in Supabase (see supabase/PROJECT_REFS.md).
# Both dev and prod use: alythcott@gmail.com
OWNER_ALLOWED_EMAIL=alythcott@gmail.com
