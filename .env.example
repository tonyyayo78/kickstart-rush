# Supabase — obtain from your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — server-side only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# The canonical URL of this deployment (used for redirects, og:url, etc.)
NEXT_PUBLIC_APP_URL=

# Email address that is granted the owner role
OWNER_ALLOWED_EMAIL=
